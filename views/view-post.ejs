<%- include("partials/header.ejs") %>
<div class="container">
    <div class="view-post-body">
        <% if (locals.post) { %>
            <h2><%= post.postName %></h2>
            <p><%= post.postDescription %></p>
            <img src= <%= post.postImage %> />
            <p><%= post.postBody %></p>
        <% } else{ %>
            <p>No post to display</p>
        <% } %>
    </div>
    <div class="view-post-creator">
        <% if (locals.post) { %>
            <span><%= post.postAuthor %></span>
            <p><%= post.postTime %></p>
        <% } else{ %>
            <span>No info available</span>
        <% } %>
    </div>
</div>
<%- include("partials/footer.ejs") %>
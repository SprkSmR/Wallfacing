<%- include("partials/header.ejs") %>
<div class="browse-content">
        <div class="view-post-body">
            <% if (postList.length == 0) { %>
                <h2>No posts available</h2>
            <% } else{  %>
                <% for( let i = 0 + (3*paging); i < postList.length && i < (3+3*paging); i++ ) { %>
                    <a href="/view-post/<%= i%>" class="view-post-preview">
                        <h3><%= postList[i].postTitle%></h3>
                        <img src="/uploads/<%= postList[i].postImage %>" width="320" height="320">
                        <p><%= postList[i].postDescription %></p>
                        <%= postList[i].postTime %> - <%= postList[i].postAuthor %>
                    </a>
                    <br/>
                <% } %>
            <% } %>
        </div>
        <div class="browse-controllers">
            <% if (paging > 0) { %>
                <a href="/browse/<%= Number(paging) - Number(1) %>">
                    <button><--</button>
                </a>
            <% } %>

            <% if ((postList.length - (3+3*paging)) > 0) { %>
                <a href="/browse/<%= Number(paging) + Number(1) %>">
                    <button>--></button>
                </a>
            <% } %>

        </div>
</div>
<%- include("partials/footer.ejs") %>
<%- include("partials/header.ejs") %>
<div class="container">
    <div class="view-post-body">
        <% if (locals.postName) { %>
            <h2><%= postName %></h2>
        <% } else{ %>
            <h2>No post available</h2>
        <% } %>

        <% if (locals.imageFile) { %>
            <img src= <%= imageFile %> />
        <% } else{ %>
            <span>No image available</span>
        <% } %>

        <% if (locals.postBody) { %>
            <p><%= postBody %></p>
        <% } else{ %>
            <p>No body available</p>
        <% } %>
    </div>
    <div class="view-post-creator">
        <% if (locals.postCreator) { %>
            <span><%= postCreator %></span>
        <% } else{ %>
            <span>No creator available</span>
        <% } %>

        <% if (locals.postDate) { %>
            <p><%= postDate %></p>
        <% } else{ %>
            <p>No date available</p>
        <% } %>
    </div>
</div>
<%- include("partials/footer.ejs") %>